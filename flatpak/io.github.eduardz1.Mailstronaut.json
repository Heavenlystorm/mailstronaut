{
  "app-id": "io.github.eduardz1.Mailstronaut",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable",
    "org.freedesktop.Sdk.Extension.llvm22"
  ],
  "command": "mailstronaut",
  "finish-args": [
    "--socket=wayland",
    "--share=network",
    "--device=dri"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm22/bin",
    "prepend-ld-library-path": "/usr/lib/sdk/llvm22/lib",
    "env": {
      "CARGO_HOME": "/run/build/mailstronaut/cargo-home",
      "CARGO_NET_OFFLINE": "true",
      "CARGO_CACHE_AUTO_CLEAN_FREQUENCY": "never",
      "LIBCLANG_PATH": "/usr/lib/sdk/llvm22/lib",
      "CC": "clang",
      "CXX": "clang++",
      "FLATPAK_DEST": "/app"
    }
  },
  "modules": [
    {
      "name": "mailstronaut",
      "buildsystem": "simple",
      "subdir": "app",
      "build-commands": [
        "bash build-app.sh"
      ],
      "sources": [
        {
          "type": "archive",
          "path": "../target/p10-flatpak/app-source.tar.xz",
          "sha256": "b94976889bacb7f5c99386be13a111d81f4610e735d53511b2b66bf39b1a8ea9",
          "strip-components": 0
        },
        {
          "type": "archive",
          "path": "../target/p10-flatpak/vendor.tar.xz",
          "sha256": "d77893cae25f7c974b10becb3837c66d9966ae0a5768dfe58fef86984130130a",
          "strip-components": 0
        },
        {
          "type": "file",
          "path": "../flatpak/io.github.eduardz1.Mailstronaut.desktop",
          "dest": "app"
        },
        {
          "type": "file",
          "path": "../flatpak/io.github.eduardz1.Mailstronaut.metainfo.xml",
          "dest": "app"
        },
        {
          "type": "file",
          "path": "../flatpak/build-app.sh",
          "dest": "app",
          "dest-filename": "build-app.sh"
        }
      ]
    }
  ]
}
